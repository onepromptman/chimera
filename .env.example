# chimera — environment template
#
# Copy this to `.env` (gitignored) and uncomment/edit any knob you want to
# override. EVERY variable here is OPTIONAL — chimera runs with safe defaults
# if the file is absent. There are NO secrets and NO API keys: chimera is
# self-authored and dependency-minimal, it holds no tokens (see CLAUDE.md, Security
# Rule #2). Never put real credentials in `.env`; if you ever do, it stays
# gitignored — only THIS template (.env.example) is tracked.
#
# Loading: the package reads os.environ directly (no python-dotenv dependency).
# A `.env` here is picked up automatically by VS Code's Python extension for
# its integrated terminal + debug/run sessions; outside VS Code, export the
# vars in your shell.

# --- Identity (commit/queue actor stamp) ---------------------------------
# Preferred display name recorded on queue transitions, claims, approvals.
# Falls back to $CHIMERA_WORKER, then `git config user.name`, then session-<host>.
# CHIMERA_AUTHOR=Your Name
# Legacy identity var, kept for back-compat (CHIMERA_AUTHOR wins if both set).
# CHIMERA_WORKER=

# --- Paths ----------------------------------------------------------------
# Override the chimera root dir (where queue/, arcs/, decisions/ resolve from).
# Defaults to the repo root via git discovery.
# CHIMERA_ROOT=
# Override the SQLite+FTS5 memory DB path. Defaults to ~/.chimera/memory.db,
# outside the repo, so run history is never a commit.
# CHIMERA_DB_PATH=

# --- Models (maker != checker is enforced in code) ------------------------
# Maker tier (scope/architect/judge/synthesize). Default: opus.
# CHIMERA_MAKER_MODEL=opus
# Critic tier (REFUTE panels, verify gate). Default: sonnet.
# verify/lite.py REFUSES to build a panel if critic == maker.
# CHIMERA_CRITIC_MODEL=sonnet

# --- Research tier --------------------------------------------------------
# Researcher role model. Default: sonnet.
# CHIMERA_RESEARCH_MODEL=sonnet

# --- Judge tier -------------------------------------------------------------
# The planner call and read-less judge (fan-in) nodes. Defaults to the maker
# value — raise it ALONE to put a higher tier on the run's shape and the
# fan-in without moving every maker up or touching the critic tier (so it can
# never collapse maker != checker). All model levers resolve at CALL time.
# CHIMERA_JUDGE_MODEL=opus

# --- MCP network grants (researcher/critic fences only) ---------------------
# Comma-separated mcp__<server>__<tool> names granted to the two read+web
# roles (e.g. Exa search). mcp__* classifies as NETWORK in roles.py, so
# write+mcp stays unconstructible. Strict list-wide parse: ANY malformed
# entry reads the WHOLE lever as unset. Unresolvable names are refused by the
# harness at subagent launch (fails closed). Re-run `chimera install-agents`
# after changing this so the role files carry the grant.
# CHIMERA_RESEARCH_MCP_TOOLS=mcp__exa__web_search_exa,mcp__exa__get_code_context_exa

# --- Graph autonomy levers (default-restrictive) --------------------------
# graph.admit() clamps every planner-emitted DAG against these. Read ONLY in
# levers.py; a typo reads as unset, so a misspelling fails closed, not open.
# Each has a hard maximum the env var cannot exceed.
# Max nodes per phase.        Default 3,  hard max 8.
# CHIMERA_GRAPH_WIDTH=3
# Max phases per plan.        Default 5,  hard max 10.
# CHIMERA_GRAPH_PHASES=5
# Max agent calls per run.    Default 40, hard max 250.
# CHIMERA_GRAPH_CALL_BUDGET=40
# Max verify repair laps.     Default 1,  hard max 3.
# CHIMERA_GRAPH_REPAIR_LAPS=1

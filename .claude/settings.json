{
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "extraKnownMarketplaces": {
    "n8n-io": {
      "source": {
        "source": "github",
        "repo": "n8n-io/skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "n8n-skills@n8n-io": true,
    "security-guidance@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/router-enforcer.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-scope-advisor.py\""
          }
        ]
      }
    ]
  }
}
